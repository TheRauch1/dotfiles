# Ghostty: let Option act as Alt, so Neovim and tmux see Alt+a (Option+a)
# instead of a typed "å". Linked to ~/.config/ghostty/config by setup.sh.
macos-option-as-alt = true

# On `ssh`, copy Ghostty's terminfo to the server (once) and fall back to
# xterm-256color where that isn't possible, so tmux/nvim work remotely.
shell-integration-features = ssh-terminfo,ssh-env
