#!/usr/bin/env bash
# durable [prompt]: a pi agent on pi-durable that finishes what it started,
# through crashes, Ctrl+C and reboots. `durable -h` for more.
dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../pi/durable" && pwd)"
if [[ ! -d $dir/node_modules/@earendil-works/pi-durable ]]; then
  echo "durable: installing pi-durable (once)..." >&2
  npm --prefix "$dir" ci --no-fund --no-audit --silent >&2 || exit 1
fi
root=$(git rev-parse --show-toplevel 2>/dev/null) && export DURABLE_CWD=${DURABLE_CWD:-$root}
exec node --no-warnings=ExperimentalWarning "$dir/main.ts" "$@"
