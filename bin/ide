#!/usr/bin/env bash
# ide [name]: tmux in charge. One tab per project (or *.cockpit workspace),
# Neovim on the left, the agent on the right (25%), lazygit on prefix g.
# Reattaches if running; after a reboot reopens every project and continues
# each agent's conversation. Keys: Ctrl+b ? (cockpit/ide/KEYS).
# prefix Q restarts the tmux server (cockpit/ide/restart.sh): it leaves a
# note for this session, and ide starts it again and reattaches.
name=${1:-ide}
home="$HOME/.config/cockpit/ide"
socket=${IDE_SOCKET:-ide}
note="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit-ide/$name.restart"
command -v tmux >/dev/null || { echo "ide needs tmux (sudo apt install tmux / brew install tmux)"; exit 1; }
while :; do
  tab=
  if [[ -f $note ]]; then
    { read -r server; read -r tab; } < "$note"
    rm -f "$note"
    echo "ide: restarting..."
    for _ in {1..50}; do kill -0 "$server" 2>/dev/null || break; sleep 0.1; done
  fi
  tmux -L "$socket" has-session -t "=$name" 2>/dev/null ||
    IDE_SELECT=$tab COLUMNS=$(tput cols) LINES=$(tput lines) "$home/start.sh" "$name"
  TMUX= tmux -L "$socket" -f "$home/tmux.conf" attach -d -t "=$name"
  status=$?
  [[ -f $note ]] || exit "$status"
done
